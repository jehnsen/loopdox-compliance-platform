# mock: route /api/v1/* to the in-repo mock API (default). live: proxy to FastAPI.
API_MODE=mock
# FastAPI base URL, used only when API_MODE=live
API_BASE_URL=http://localhost:8000/api/v1
# Name of the httpOnly access-token cookie (refresh cookie gets a "_refresh" suffix)
SESSION_COOKIE_NAME=loopdox_session
# Product name shown in the UI (temporary; one place to rename)
NEXT_PUBLIC_APP_NAME=LoopDox
# Mock mode only: secret used to sign mock JWTs. Any long random string.
MOCK_JWT_SECRET=dev-only-change-me-dev-only-change-me
